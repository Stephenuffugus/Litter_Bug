{
  "scripts": {
    "lint": "eslint --ext .html index.html",
    "lint:summary": "eslint --ext .html --format json index.html > /tmp/eslint-report.json; node scripts/lint-summary.js",
    "smoke": "node scripts/smoke.js && node scripts/smoke-lab.js && node scripts/smoke-preview.js && node scripts/smoke-mint.js",
    "wings": "node scripts/import-art.js wings",
    "wings:gen": "node scripts/gen-wings.js && node scripts/import-art.js wings",
    "wings:contact": "node scripts/contact-sheet.js wings",
    "bodies": "node scripts/import-art.js bodies",
    "bodies:gen": "node scripts/gen-bodies.js && node scripts/import-art.js bodies",
    "bodies:contact": "node scripts/contact-sheet.js bodies",
    "heads": "node scripts/import-art.js heads",
    "heads:gen": "node scripts/gen-heads.js && node scripts/import-art.js heads",
    "heads:contact": "node scripts/contact-sheet.js heads",
    "patterns": "node scripts/import-art.js patterns",
    "patterns:gen": "node scripts/gen-patterns.js && node scripts/import-art.js patterns",
    "patterns:contact": "node scripts/contact-sheet.js patterns",
    "legs": "node scripts/import-art.js legs",
    "legs:gen": "node scripts/gen-legs.js && node scripts/import-art.js legs",
    "antennae": "node scripts/import-art.js antennae",
    "antennae:gen": "node scripts/gen-antennae.js && node scripts/import-art.js antennae",
    "art": "npm run wings && npm run bodies && npm run heads && npm run legs && npm run antennae && npm run patterns",
    "art:contact": "npm run wings:contact && npm run bodies:contact && npm run heads:contact && npm run patterns:contact",
    "status": "node scripts/status.js",
    "check": "npm run smoke"
  },
  "dependencies": {
    "puppeteer": "^24.43.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-plugin-html": "^8.1.4",
    "jsdom": "^29.1.1"
  }
}
